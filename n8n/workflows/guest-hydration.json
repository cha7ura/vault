        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"{{ $('Split Guests').item.json.name }} LinkedIn Twitter social media\",\n  \"sources\": [\"web\"],\n  \"limit\": 3,\n  \"scrapeOptions\": {\n    \"formats\": [\"markdown\"],\n    \"onlyMainContent\": true\n  }\n}",
