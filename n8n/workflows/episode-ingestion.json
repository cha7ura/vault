{
  "name": "Vault Episode Ingestion (Multi-tenant)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "ingest-channel",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook: Ingest Channel",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "ingest-channel"
    },
    {
      "parameters": {
        "jsCode": "// Extract channel from webhook body\nconst body = $input.item.json.body || $input.item.json;\nconst channelInput = body.channel || body.channelUrl || body.channelId;\n\nif (!channelInput) {\n  throw new Error('Missing channel parameter. Provide channel URL or ID.');\n}\n\n// Determine if it's a URL or direct ID\nlet channelId = channelInput;\nlet needsResolve = false;\n\nif (channelInput.includes('youtube.com')) {\n  needsResolve = true;\n} else if (channelInput.startsWith('@')) {\n  needsResolve = true;\n} else if (!channelInput.startsWith('UC')) {\n  needsResolve = true;\n}\n\nreturn {\n  json: {\n    channelInput,\n    channelId: needsResolve ? null : channelInput,\n    needsResolve,\n    limit: body.limit || 10,\n    skipExisting: body.skipExisting !== false\n  }\n};"
      },
      "id": "parse-input",
      "name": "Parse Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "needs-resolve",
              "leftValue": "={{ $json.needsResolve }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-needs-resolve",
      "name": "Needs Resolution?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/youtube/v3/channels",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "key",
              "value": "={{ $env.YOUTUBE_API_KEY }}"
            },
            {
              "name": "forHandle",
              "value": "={{ $('Parse Input').item.json.channelInput.replace('@', '').replace('https://www.youtube.com/', '').replace('youtube.com/', '') }}"
            },
            {
              "name": "part",
              "value": "id,snippet,statistics"
            }
          ]
        },
        "options": {}
      },
      "id": "resolve-channel",
      "name": "Resolve Channel ID",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, -100]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.item.json;\nconst parseInput = $('Parse Input').item.json;\n\nlet channelId, channelName, channelDescription, thumbnailUrl;\n\nif (data.items && data.items.length > 0) {\n  const item = data.items[0];\n  channelId = item.id;\n  channelName = item.snippet.title;\n  channelDescription = item.snippet.description;\n  thumbnailUrl = item.snippet.thumbnails.high?.url || item.snippet.thumbnails.default?.url;\n} else {\n  // Fallback: assume input was already a channel ID\n  channelId = parseInput.channelInput.replace(/.*\\/channel\\//, '').replace(/[?#].*/, '');\n  channelName = 'Unknown Channel';\n}\n\nreturn {\n  json: {\n    channelId,\n    channelName,\n    channelDescription,\n    thumbnailUrl,\n    limit: parseInput.limit,\n    skipExisting: parseInput.skipExisting\n  }\n};"
      },
      "id": "extract-channel-info",
      "name": "Extract Channel Info",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [880, -100]
    },
    {
      "parameters": {
        "jsCode": "// Direct channel ID provided\nconst parseInput = $input.item.json;\n\nreturn {\n  json: {\n    channelId: parseInput.channelId,\n    channelName: null, // Will be fetched later\n    limit: parseInput.limit,\n    skipExisting: parseInput.skipExisting\n  }\n};"
      },
      "id": "use-direct-id",
      "name": "Use Direct ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 100]
    },
    {
      "parameters": {
