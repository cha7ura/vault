# Aiven Postgres (required) — full connection string with sslmode=require
AIVEN_DATABASE_URL=postgres://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require

# Groq (required for wiki extraction)
GROQ_API_KEY=gsk_...

# OpenRouter (required for episode summaries)
OPENROUTER_API_KEY=sk-or-...

# Wiki directory (default: ./wiki)
# WIKI_DIR=./wiki
# WIKI_EXTRACT_MODEL=openai/gpt-oss-20b
# WIKI_SUMMARY_MODEL=deepseek/deepseek-chat
# WIKI_LINT_MODEL=llama-3.1-8b-instant

# Optional: Meilisearch (future)
# NEXT_PUBLIC_MEILISEARCH_HOST=http://localhost:7700
# NEXT_PUBLIC_MEILISEARCH_KEY=
